{
	"info": {
		"_postman_id": "e2f1a94b-9e8c-4f71-87ab-f0896cbda512",
		"name": "SOA Project - Flexible Benefit & Health Claim Verification API",
		"description": "Postman Collection สำหรับทดสอบ RESTful API โครงงานวิชา Service-Oriented Architecture (SOA)\n- ระบบจัดการสวัสดิการยืดหยุ่นและเคลมประกันสุขภาพภายในองค์กร",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "claim_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication (ระบบยืนยันตัวตน)",
			"item": [
				{
					"name": "1.1 สมัครสมาชิกพนักงานใหม่ (Register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"somchai_test\",\n    \"email\": \"somchai@company.com\",\n    \"password\": \"password123\",\n    \"confirm_password\": \"password123\",\n    \"first_name\": \"สมชาย\",\n    \"last_name\": \"ใจดี\",\n    \"department\": \"Information Technology\",\n    \"policy_number\": \"INS-2026-999\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register", ""]
						}
					}
				},
				{
					"name": "1.2 เข้าสู่ระบบรับ JWT Token (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"    console.log(\"Access Token auto-saved to collection variable!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"67310124\",\n    \"password\": \"admin1234\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login", ""]
						}
					}
				},
				{
					"name": "1.3 ขอ Refresh Token เมื่อ Token หมดอายุ",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"ใส่_refresh_token_ที่นี่\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/token/refresh/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "token", "refresh", ""]
						}
					}
				},
				{
					"name": "1.4 ดูข้อมูลส่วนตัวและแต้มคงเหลือ (Profile)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/profile/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "profile", ""]
						}
					}
				}
			]
		},
		{
			"name": "2. Categories (หมวดหมู่สวัสดิการ)",
			"item": [
				{
					"name": "2.1 รายการหมวดหมู่สวัสดิการทั้งหมด",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/categories/",
							"host": ["{{base_url}}"],
							"path": ["api", "categories", ""]
						}
					}
				}
			]
		},
		{
			"name": "3. Claims (ระบบยื่นเคลมสวัสดิการ)",
			"item": [
				{
					"name": "3.1 ยื่นเคลมหมวดสุขภาพ (ประกันจ่าย 70%)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.claim && jsonData.claim.id) {",
									"    pm.collectionVariables.set(\"claim_id\", jsonData.claim.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"category_id\": 15,\n    \"title\": \"ค่าตรวจสุขภาพประจำปี รพ.กรุงเทพ\",\n    \"receipt_number\": \"INV-HLTH-2026-001\",\n    \"receipt_amount\": 3000.00,\n    \"medical_code\": \"MED-CHK\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/claims/",
							"host": ["{{base_url}}"],
							"path": ["api", "claims", ""]
						}
					}
				},
				{
					"name": "3.2 ยื่นเคลมหมวดทั่วไป/การเรียนรู้ (ประกันไม่จ่าย)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"category_id\": 17,\n    \"title\": \"คอร์สเรียนคลาวด์และสถาปัตยกรรม SOA\",\n    \"receipt_number\": \"INV-LRN-2026-002\",\n    \"receipt_amount\": 1500.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/claims/",
							"host": ["{{base_url}}"],
							"path": ["api", "claims", ""]
						}
					}
				},
				{
					"name": "3.3 ประวัติการเคลมของฉัน (My Claims)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/claims/my-claims/",
							"host": ["{{base_url}}"],
							"path": ["api", "claims", "my-claims", ""]
						}
					}
				},
				{
					"name": "3.4 รายการรออนุมัติ (เฉพาะ HR Admin)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/claims/pending/",
							"host": ["{{base_url}}"],
							"path": ["api", "claims", "pending", ""]
						}
					}
				},
				{
					"name": "3.5 HR กดอนุมัติและหักแต้ม (Approve)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/claims/{{claim_id}}/approve/",
							"host": ["{{base_url}}"],
							"path": ["api", "claims", "{{claim_id}}", "approve", ""]
						}
					}
				},
				{
					"name": "3.6 HR กดปฏิเสธคำขอ (Reject)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"เอกสารใบเสร็จไม่ครบถ้วนตามเกณฑ์สวัสดิการ\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/claims/{{claim_id}}/reject/",
							"host": ["{{base_url}}"],
							"path": ["api", "claims", "{{claim_id}}", "reject", ""]
						}
					}
				},
				{
					"name": "3.7 พนักงานยกเลิกคำขอสถานะ PENDING (DELETE)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/claims/{{claim_id}}/",
							"host": ["{{base_url}}"],
							"path": ["api", "claims", "{{claim_id}}", ""]
						}
					}
				}
			]
		},
		{
